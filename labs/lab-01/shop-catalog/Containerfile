# ---- stage 1: build ----
FROM registry.access.redhat.com/ubi9/python-312:9.6 AS build
# behind Nexus: --build-arg PIP_INDEX_URL=https://nexus.../simple (pip reads it from the env)
ARG PIP_INDEX_URL=https://pypi.org/simple
COPY --chown=1001:0 requirements.txt .
RUN pip install --no-cache-dir --target /tmp/deps \
      -r requirements.txt                # cached layer
COPY --chown=1001:0 app ./app
# readable for every UID: OpenShift starts the image with a random UID and group 0
RUN chmod -R g=u,o=rX /tmp/deps ./app

# ---- stage 2: runtime ----
FROM registry.access.redhat.com/ubi9/python-312-minimal:9.6
ARG VERSION=dev REVISION=unknown
LABEL org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.revision=$REVISION
WORKDIR /opt/app-root/src
ENV PYTHONPATH=/opt/app-root/deps \
    APP_VERSION=$VERSION APP_REVISION=$REVISION
COPY --from=build /tmp/deps /opt/app-root/deps
COPY --from=build /opt/app-root/src/app ./app
USER 1001
EXPOSE 8080
CMD ["python3", "-m", "uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8080"]
