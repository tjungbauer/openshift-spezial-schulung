{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACME shop chart values",
  "type": "object",
  "required": ["image", "web", "catalog", "cart", "orders", "review", "postgresql", "backup"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["registry", "tag"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "suffix": { "type": "string" },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "logLevel": { "enum": ["debug", "info", "warning", "error"] },
    "web": {
      "type": "object",
      "properties": {
        "replicas": { "$ref": "#/definitions/replicas" },
        "resources": { "type": "object" },
        "route": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" }
          }
        }
      }
    },
    "catalog": { "$ref": "#/definitions/component" },
    "cart": { "$ref": "#/definitions/component" },
    "review": {
      "allOf": [{ "$ref": "#/definitions/component" }],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "orders": {
      "allOf": [{ "$ref": "#/definitions/component" }],
      "properties": {
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
            "storageClassName": { "type": "string" }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "auth": {
          "type": "object",
          "required": ["user", "password", "database"],
          "properties": {
            "user": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 8 },
            "database": { "type": "string", "minLength": 1 }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
            "storageClassName": { "type": "string" }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 9 },
        "keep": { "type": "integer", "minimum": 1 },
        "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
        "storageClassName": { "type": "string" },
        "viewerImage": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicies": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "monitoring": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "definitions": {
    "replicas": { "type": "integer", "minimum": 0 },
    "component": {
      "type": "object",
      "properties": {
        "replicas": { "$ref": "#/definitions/replicas" },
        "resources": { "type": "object" }
      }
    }
  }
}
